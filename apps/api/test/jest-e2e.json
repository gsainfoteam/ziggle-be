{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../../..",
  "testEnvironment": "node",
  "testRegex": "apps/api/test/.*\\.e2e-spec\\.ts$",
  "setupFiles": ["<rootDir>/apps/api/test/test-env.ts"],
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": { "allowJs": true } }]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!@gsainfoteam|jose|oauth4webapi|@faker-js)"
  ],
  "moduleNameMapper": {
    "^@generated/prisma/client$": "<rootDir>/generated/prisma/client/client.ts",
    "^@lib/([^/]+)(|/.*)$": "<rootDir>/libs/$1/src$2"
  }
}
